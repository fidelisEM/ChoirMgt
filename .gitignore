# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local dart-define credential files (contain real Supabase keys) - only
# the .example templates are meant to be tracked.
/env/*.json
!/env/*.json.example

# Android signing / local SDK paths - machine-specific and/or secret.
android/local.properties
android/key.properties
**/*.jks
**/*.keystore

# iOS signing.
**/*.mobileprovision
**/*.p12

# Firebase CLI local cache (not the checked-in .firebaserc/firebase.json).
.firebase/
firebase-debug.log
firebase-export-*/

# Supabase CLI local cache/link state (project ref, temp session info) -
# not meant to be shared; re-created by `supabase link`.
supabase/.temp/
