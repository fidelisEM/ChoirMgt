# Environment Configuration
ENVIRONMENT=development

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Configuration (Optional - for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_SENDER_ID=your-firebase-sender-id

# App Configuration
APP_NAME=Choir Management System
APP_VERSION=1.0.0

# Security Configuration
SECRET_KEY=your-secret-key
SESSION_TIMEOUT=4

# Features Configuration
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_LOGGING=false
ENABLE_PUSH_NOTIFICATIONS=false

# Performance Configuration
MAX_IMAGE_SIZE=2097152
MAX_CACHE_SIZE=52428800
NETWORK_TIMEOUT=60
CACHE_TIMEOUT=3600

# Support Configuration
SUPPORT_EMAIL=support@choirmanagement.com
PRIVACY_POLICY_URL=https://choirmanagement.com/privacy
TERMS_OF_SERVICE_URL=https://choirmanagement.com/terms