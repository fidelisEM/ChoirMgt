<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="database" />
        <exclude domain="sharedpref" path="user_session" />
        <exclude domain="sharedpref" path="auth_tokens" />
        <exclude domain="file" path="secure/" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="database" />
        <exclude domain="sharedpref" path="user_session" />
        <exclude domain="sharedpref" path="auth_tokens" />
        <exclude domain="file" path="secure/" />
    </device-transfer>
</data-extraction-rules>